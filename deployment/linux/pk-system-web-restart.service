[Unit]
Description=Handle an IELTSRoom web request to restart the Java service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=oneshot
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/pk-system-web-restart /run/lock /var/lib/pk-deploy-control
TimeoutStartSec=300
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/python3 /usr/local/lib/pk-deploy/pk_deploy.py web-restart
