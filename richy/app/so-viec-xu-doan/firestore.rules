rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chỉ nhận phiên Google có email đã xác minh.
    function signedInWithGoogle() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isMember() {
      return signedInWithGoogle()
        && exists(/databases/$(database)/documents/members/$(myEmail()))
        && get(/databases/$(database)/documents/members/$(myEmail())).data.email == myEmail();
    }

    function isAdmin() {
      return isMember()
        && get(/databases/$(database)/documents/members/$(myEmail())).data.laQuanTri == true;
    }

    function shortText(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function validMember(id, data) {
      return data.keys().hasAll(['email', 'hoTen', 'tenGoi', 'laQuanTri'])
        && data.keys().hasOnly(['banNganh', 'vaiTro', 'hoTen', 'tenGoi', 'dienThoai',
          'mangDieuHanh', 'viecChinh', 'email', 'laQuanTri'])
        && shortText(data.email, 254)
        && (data.email == id && data.email == data.email.lower()
              && data.email.matches('^[^ /@]+@[^ /@]+[.][^ /@]+$')
          || data.email == '' && id.matches('^nhan-su-[a-f0-9]{64}$'))
        && shortText(data.hoTen, 120) && data.hoTen.size() > 0
        && shortText(data.tenGoi, 50) && data.tenGoi.size() > 0
        && data.laQuanTri is bool
        && (data.email != '' || data.laQuanTri == false)
        && shortText(data.get('banNganh', ''), 120)
        && shortText(data.get('vaiTro', ''), 120)
        && shortText(data.get('dienThoai', ''), 40)
        && shortText(data.get('mangDieuHanh', ''), 120)
        && shortText(data.get('viecChinh', ''), 2000);
    }

    match /members/{id} {
      // Người mới chỉ đọc được chính email của mình để kiểm tra đã được cấp quyền.
      allow get: if isMember() || signedInWithGoogle() && id == myEmail();
      allow list: if isMember();
      allow create, update: if isAdmin() && validMember(id, request.resource.data);
      allow delete: if isAdmin();
    }

    function validTask(data) {
      return data.keys().hasAll(['tieuDe', 'ngay', 'trangThai', 'ban', 'nguoiPhuTrach',
          'dot', 'ghiChu', 'nguoiTao', 'nguoiSuaCuoi', 'thoiGianSua'])
        && data.keys().hasOnly(['tieuDe', 'ngay', 'trangThai', 'ban', 'nguoiPhuTrach',
          'dot', 'ghiChu', 'nguoiTao', 'nguoiSuaCuoi', 'thoiGianSua'])
        && shortText(data.tieuDe, 300) && data.tieuDe.size() > 0
        && data.ngay is string
        && (data.ngay == '' || data.ngay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.trangThai in ['Chưa làm', 'Đang làm', 'Xong']
        && shortText(data.ban, 120)
        && data.nguoiPhuTrach is list && data.nguoiPhuTrach.size() <= 30
        && shortText(data.dot, 150) && shortText(data.ghiChu, 10000)
        && shortText(data.nguoiTao, 254)
        && data.nguoiSuaCuoi == myEmail()
        && data.thoiGianSua == request.time;
    }

    match /tasks/{id} {
      allow read: if isMember();
      allow create: if isMember() && (!id.matches('^csv-.*') || isAdmin())
        && validTask(request.resource.data)
        && request.resource.data.nguoiTao == myEmail();
      allow update: if isMember() && validTask(request.resource.data)
        && request.resource.data.nguoiTao == resource.data.nguoiTao;
      allow delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();
    }

    // Đường dẫn khác đều được khóa, kể cả các collection con chưa dùng.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
