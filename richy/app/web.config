<?xml version="1.0" encoding="UTF-8"?>
<configuration>
<system.webServer>
  <rewrite>
    <rules>
      <!-- API calls must reach Spring before the Angular page fallback. -->
      <rule name="Backend service" stopProcessing="true">
        <match url="^service(?:/(.*))?$" />
        <action type="Rewrite" url="http://127.0.0.1:8085/service/{R:1}" appendQueryString="true" />
      </rule>
      <rule name="TNTT public SEO files" stopProcessing="true">
        <match url="^(robots\.txt|sitemap\.xml)$" />
        <conditions><add input="{HTTP_HOST}" pattern="^(www\.)?tnttphungkhoang\.com(:[0-9]+)?$" /></conditions>
        <action type="Rewrite" url="seo/tntt-{R:1}" appendQueryString="false" />
      </rule>
      <rule name="IELTS public SEO files" stopProcessing="true">
        <match url="^(robots\.txt|sitemap\.xml)$" />
        <action type="Rewrite" url="seo/ieltsroom-{R:1}" appendQueryString="false" />
      </rule>
      <rule name="TNTT public introduction" stopProcessing="true">
        <match url="^gioi-thieu/?$" />
        <conditions><add input="{HTTP_HOST}" pattern="^(www\.)?tnttphungkhoang\.com(:[0-9]+)?$" /></conditions>
        <action type="Rewrite" url="seo/tntt-about.html" appendQueryString="false" />
      </rule>
      <rule name="IELTS public introduction" stopProcessing="true">
        <match url="^gioi-thieu/?$" />
        <action type="Rewrite" url="seo/ieltsroom-about.html" appendQueryString="false" />
      </rule>
      <rule name="TNTT favicon fallback" stopProcessing="true">
        <match url="^favicon\.ico$" />
        <conditions>
          <add input="{HTTP_HOST}" pattern="^(www\.)?tnttphungkhoang\.com(:[0-9]+)?$" />
        </conditions>
        <action type="Redirect" url="/assets/images/troop-1.jpg" redirectType="Found" appendQueryString="false" />
      </rule>
      <rule name="Default favicon fallback" stopProcessing="true">
        <match url="^favicon\.ico$" />
        <action type="Redirect" url="/assets/images/troop.jpg" redirectType="Found" appendQueryString="false" />
      </rule>
      <rule name="RewriteRules" stopProcessing="true">
        <match url=".*" />
        <conditions logicalGrouping="MatchAll">
          <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          <add input="{REQUEST_URI}" pattern="^/(?:api|service|oauth|public)(?:/|$)" negate="true" />
        </conditions>
        <action type="Rewrite" url="/index.html" />
      </rule>
    </rules>
    <!-- Serve domain-specific metadata in raw HTML; link-preview crawlers do not run Angular. -->
    <outboundRules>
      <!-- A fresh entry page supplies the current asset versions after each release. -->
      <rule name="App entry Cache-Control" preCondition="AppEntryHtmlResponse">
        <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
        <action type="Rewrite" value="no-cache, no-store, must-revalidate" />
      </rule>
      <rule name="App entry Pragma" preCondition="AppEntryHtmlResponse">
        <match serverVariable="RESPONSE_Pragma" pattern=".*" />
        <action type="Rewrite" value="no-cache" />
      </rule>
      <rule name="App entry Expires" preCondition="AppEntryHtmlResponse">
        <match serverVariable="RESPONSE_Expires" pattern=".*" />
        <action type="Rewrite" value="0" />
      </rule>
      <rule name="Private app indexing" preCondition="PrivateAppHtmlResponse">
        <match serverVariable="RESPONSE_X_Robots_Tag" pattern=".*" />
        <action type="Rewrite" value="noindex, nofollow" />
      </rule>
      <rule name="Private app robots meta" preCondition="PrivateAppHtmlResponse">
        <match filterByTags="None" occurrences="1" pattern="(&lt;meta name=&quot;robots&quot;\s+content=&quot;)[^&quot;]*(&quot;\s*/?&gt;)" />
        <action type="Rewrite" value="{R:1}noindex, nofollow{R:2}" />
      </rule>
      <rule name="Private app canonical" preCondition="PrivateAppHtmlResponse">
        <match filterByTags="None" occurrences="1" pattern="&lt;link id=&quot;site-canonical&quot;[^&gt;]*&gt;" />
        <action type="Rewrite" value="" />
      </rule>
      <rule name="TNTT document title" preCondition="TnttHtmlResponse">
        <match filterByTags="None" occurrences="1" pattern="(&lt;title id=&quot;site-title&quot;&gt;)[^&lt;]*(&lt;/title&gt;)" />
        <action type="Rewrite" value="{R:1}TNTT Phùng Khoang | Thiếu Nhi Thánh Thể Phùng Khoang{R:2}" />
      </rule>
      <rule name="TNTT document description" preCondition="TnttHtmlResponse">
        <match filterByTags="None" occurrences="1" pattern="(&lt;meta name=&quot;description&quot;\s+content=&quot;)[^&quot;]*(&quot;\s*/?&gt;)" />
        <action type="Rewrite" value="{R:1}Website Thiếu Nhi Thánh Thể Phùng Khoang: kết nối học tập, sinh hoạt xứ đoàn, lớp và đội, cùng các chiến dịch và hoa thiêng.{R:2}" />
      </rule>
      <rule name="TNTT document canonical" preCondition="TnttHtmlResponse">
        <match filterByTags="None" occurrences="1" pattern="(&lt;link id=&quot;site-canonical&quot;\s+rel=&quot;canonical&quot;\s+href=&quot;)[^&quot;]*(&quot;\s*/?&gt;)" />
        <action type="Rewrite" value="{R:1}https://tnttphungkhoang.com/{R:2}" />
      </rule>
      <rule name="TNTT website structured data" preCondition="TnttHtmlResponse">
        <match filterByTags="None" occurrences="1" pattern="(&lt;script type=&quot;application/ld\+json&quot; id=&quot;site-structured-data&quot;&gt;)(\{)[\s\S]*?(\})(&lt;/script&gt;)" />
        <action type="Rewrite" value="{R:1}{R:2}&quot;@context&quot;:&quot;https://schema.org&quot;,&quot;@type&quot;:&quot;WebSite&quot;,&quot;name&quot;:&quot;TNTT Phùng Khoang&quot;,&quot;alternateName&quot;:&quot;Thiếu Nhi Thánh Thể Phùng Khoang&quot;,&quot;url&quot;:&quot;https://tnttphungkhoang.com/&quot;,&quot;inLanguage&quot;:&quot;vi&quot;,&quot;publisher&quot;:{R:2}&quot;@type&quot;:&quot;Organization&quot;,&quot;name&quot;:&quot;Thiếu Nhi Thánh Thể Phùng Khoang&quot;,&quot;url&quot;:&quot;https://tnttphungkhoang.com/&quot;,&quot;logo&quot;:&quot;https://tnttphungkhoang.com/assets/images/troop-1.jpg&quot;{R:3}{R:3}{R:4}" />
      </rule>
      <rule name="TNTT favicon" preCondition="TnttHtmlResponse">
        <match filterByTags="None" occurrences="1" pattern="(&lt;link id=&quot;site-favicon&quot;\s+rel=&quot;icon&quot;\s+type=&quot;image/jpeg&quot;\s+href=&quot;)[^&quot;]*(&quot;\s*/?&gt;)" />
        <action type="Rewrite" value="{R:1}/assets/images/troop-1.jpg{R:2}" />
      </rule>
      <rule name="TNTT share title" preCondition="TnttHtmlResponse">
        <match filterByTags="None" occurrences="1" pattern="(&lt;meta property=&quot;og:title&quot;\s+content=&quot;)[^&quot;]*(&quot;\s*/?&gt;)" />
        <action type="Rewrite" value="{R:1}TNTT PHÙNG KHOANG{R:2}" />
      </rule>
      <rule name="TNTT share description" preCondition="TnttHtmlResponse">
        <match filterByTags="None" occurrences="1" pattern="(&lt;meta property=&quot;og:description&quot;\s+content=&quot;)[^&quot;]*(&quot;\s*/?&gt;)" />
        <action type="Rewrite" value="{R:1}Thiếu Nhi Thánh Thể Phùng Khoang · Chiến dịch và Hoa thiêng{R:2}" />
      </rule>
      <rule name="TNTT share URL" preCondition="TnttHtmlResponse">
        <match filterByTags="None" occurrences="1" pattern="(&lt;meta property=&quot;og:url&quot;\s+content=&quot;)[^&quot;]*(&quot;\s*/?&gt;)" />
        <action type="Rewrite" value="{R:1}https://tnttphungkhoang.com{HtmlEncode:{UNENCODED_URL}}{R:2}" />
      </rule>
      <rule name="TNTT share image" preCondition="TnttHtmlResponse">
        <match filterByTags="None" occurrences="1" pattern="(&lt;meta property=&quot;og:image&quot;\s+content=&quot;)[^&quot;]*(&quot;\s*/?&gt;)" />
        <action type="Rewrite" value="{R:1}https://tnttphungkhoang.com/assets/images/troop-1.jpg{R:2}" />
      </rule>
      <preConditions>
        <preCondition name="PrivateAppHtmlResponse" logicalGrouping="MatchAll">
          <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html(?:;|$)" />
          <add input="{REQUEST_FILENAME}" pattern="(?:^|[\\/])index\.html$" />
          <add input="{UNENCODED_URL}" pattern="^/(?:index\.html|login)?/?(?:\?.*)?$" negate="true" />
          <add input="{REQUEST_URI}" pattern="^/(?:api|service|oauth|public|assets)(?:/|$)" negate="true" />
        </preCondition>
        <preCondition name="AppEntryHtmlResponse" logicalGrouping="MatchAll">
          <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html(?:;|$)" />
          <add input="{REQUEST_FILENAME}" pattern="(?:^|[\\/])index\.html$" />
          <add input="{REQUEST_URI}" pattern="^/(?:api|service|oauth|public|assets)(?:/|$)" negate="true" />
        </preCondition>
        <preCondition name="TnttHtmlResponse">
          <add input="{HTTP_HOST}" pattern="^(www\.)?tnttphungkhoang\.com(:[0-9]+)?$" />
          <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html(?:;|$)" />
          <add input="{REQUEST_FILENAME}" pattern="(?:^|[\\/])index\.html$" />
        </preCondition>
      </preConditions>
    </outboundRules>
  </rewrite>

</system.webServer>
<!-- Outbound metadata rewriting needs the app HTML before compression. Assets keep compression. -->
<location path="index.html">
  <system.webServer>
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
  </system.webServer>
</location>
</configuration>
